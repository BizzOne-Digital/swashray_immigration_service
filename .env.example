# Copy to .env.local for development; set these in the host for production.
MONGODB_URI=

# Generate a long random secret (minimum 16 characters); keep stable across deploys.
AUTH_SECRET=

# Initial admin provisioning only: fill these before running npm run seed.
# Rerunning the seed resets this account's password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Replace with the HTTPS public domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
